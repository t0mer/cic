CIC_MQTT_BROKER_HOST=
CIC_MQTT_BROKER_PORT=1883
CIC_MQTT_BROKER_USERNAME=
CIC_MQTT_BROKER_PASSWORD=
CIC_GEOCODE_API_KEY=
CIC_AUTH_OIDC_CLIENT_SECRET=
